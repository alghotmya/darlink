# Copy this file to .env and fill in your values.
# Do not commit .env to git.

# AWS (for backend deploy and/or frontend auth)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-south-1

# Cognito (after first deploy - from CDK output)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# API base URL (after deploy)
VITE_API_BASE_URL=

# Git / optional (e.g. for CI or scripts)
GIT_TOKEN=
GITHUB_TOKEN=
